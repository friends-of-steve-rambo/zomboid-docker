ADMINUSERNAME=admin
ADMINPASSWORD=
PASSWORD=

# RCON-пароль для PZ и веб-панели
RCONPASSWORD=

SERVERNAME=servertest
DISPLAYNAME=Steve Rambo was here
PUBLIC=false

PORT=16261
UDPPORT=16262
STEAMPORT1=8766
STEAMPORT2=8767
STEAMVAC=false

MIN_MEMORY=2048m
MAX_MEMORY=5120m

# Директории сейва и модов (persistent volume)
PROJECT_ZOMBOID_DATA=./data
PROJECT_ZOMBOID_WORKSHOP_MODS=./workshop-mods

# GID сокета Docker для веб-панели (stat -c '%g' /var/run/docker.sock)
DOCKER_GID=990

# Эти строки заполняет скрипт, моды берет из server-mods.yaml:
# python3 scripts/sync_mods_env.py
WORKSHOP_IDS=
MOD_IDS=
