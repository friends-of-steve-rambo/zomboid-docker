ADMINUSERNAME=admin
ADMINPASSWORD=
PASSWORD=

# RCON-пароль для PZ и веб-панели
RCONPASSWORD=

SERVERNAME=servertest
DISPLAYNAME=Steve Rambo was here
PUBLIC=false

PORT=16261
UDPPORT=16262
STEAMPORT1=8766
STEAMPORT2=8767
STEAMVAC=false

MIN_MEMORY=2048m
MAX_MEMORY=4096m

# Директории сейва и модов (persistent volume)
PROJECT_ZOMBOID_DATA=./data
PROJECT_ZOMBOID_WORKSHOP_MODS=./workshop-mods

# GID сокета Docker для веб-панели (stat -c '%g' /var/run/docker.sock)
DOCKER_GID=990

# Не удалять: Mods и WorkshopItems в data/Server/servertest.ini
SELF_MANAGED_MODS=true
